# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Models -----------------------------------------------------------------
# compose and resolve run on Anthropic. verify runs on a different family on
# purpose: a model checking its own output shares its own blind spots.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings. Both are populated during decision log entry D1, which measures a
# general-purpose model against a legal-domain one before either is adopted.
VOYAGE_API_KEY=

# --- Corpus sources ---------------------------------------------------------
# eCFR (federal) needs no key.
# California and Ohio are server-rendered HTML and need no key.
# New York Open Legislation requires a free key: https://legislation.nysenate.gov/
NY_SENATE_API_KEY=

# --- Vector store -----------------------------------------------------------
# Local default matches docker-compose. Production points at Qdrant Cloud.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Tracing ----------------------------------------------------------------
# Langfuse Cloud free tier is used in both local and production, so traces from
# development and the live demo land in one place.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Protection layer -------------------------------------------------------
# Bounds spend on the public demo. See spec, "Protection layer".
GLOBAL_DAILY_REQUEST_LIMIT=500
PER_IP_HOURLY_LIMIT=20
MAX_INPUT_CHARS=1000

# --- DL-24: the open-weights arm ------------------------------------------
# Any OpenAI-compatible endpoint. Groq, Cerebras, OpenRouter and Together all
# work; only these three values change. The provider MUST honour tool_choice,
# because forced structured output is the contract every node depends on.
#
#   Groq      https://api.groq.com/openai/v1
#   Cerebras  https://api.cerebras.ai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai/
OPEN_MODEL_API_KEY=
OPEN_MODEL_ID=llama-3.3-70b-versatile
OPEN_MODEL_BASE_URL=https://api.groq.com/openai/v1

# Two limits, not one, and they are not the same number.
#
# OPEN_MODEL_TPM             tokens per MINUTE, paces the run
# OPEN_MODEL_MAX_REQUEST_TOKENS  tokens per REQUEST, sizes each call
#
# They coincide on Groq's free tier at 8,000 and nowhere else, which is what
# made the per-request ceiling invisible until 23% of resolve prompts failed.
# On Groq the ceiling is what blocks the precedence arm: the prompts that do not
# fit are systematically the evidence-heaviest, so scoring the rest would
# flatter the model rather than measure it.
OPEN_MODEL_TPM=8000
OPEN_MODEL_MAX_REQUEST_TOKENS=8000

# --- Google Gemini: free tier, OpenAI-compatible ---------------------------
# Kept under its own name and swapped into OPEN_MODEL_API_KEY at run time, so
# two providers can sit in one .env without either clobbering the other.
#
# **Do not append a second OPEN_MODEL_* block to add a provider.** dotenv takes
# the last occurrence of a key, so an appended block with empty values silently
# blanks a working configuration and the run fails as an authentication error
# somewhere else entirely. That happened, and it cost a debugging session.
GEMINI_API_KEY=

# --- Observability ----------------------------------------------------------
# Langfuse. Region must match the keys: EU is cloud.langfuse.com, US is
# us.cloud.langfuse.com. A mismatch is a silent auth failure.

# TRACE_REDACT=1 sends trace STRUCTURE without CONTENT: routes, precedence
# rules, citations, filters and timings, but no question, no personal facts and
# no answer text. Off by default because this is a demo with no real employees.
# **Turn it on for any deployment with real ones, or self-host Langfuse.**
TRACE_REDACT=
# LANGFUSE_DEBUG=1 re-raises export failures instead of swallowing them. For
# development only: export is deliberately silent in production.
LANGFUSE_DEBUG=
